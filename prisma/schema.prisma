generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    String         @id @default(cuid())
  email                 String?        @unique
  phone                 String?        @unique
  name                  String?
  password              String?
  role                  String         @default("FARMER") // FARMER, VETERINARIAN, FIELD_WORKER, LABORATORY, ADMIN, STATE_OFFICER, DISTRICT_OFFICER, TALUKA_OFFICER
  status                String         @default("APPROVED") // PENDING, APPROVED, REJECTED, SUSPENDED, PENDING_REVIEW
  language              String         @default("mr") // mr, hi, en
  registrationNo        String?
  jurisdictionLevel     String         @default("STATE") // STATE, DISTRICT, TALUKA, VILLAGE
  jurisdictionState     String         @default("Maharashtra")
  jurisdictionDistrict  String?        // e.g. "Pune"
  jurisdictionTaluka    String?        // e.g. "Haveli"
  jurisdictionVillage   String?
  createdAt             DateTime       @default(now())
  animals               Animal[]       // If farmer
  reportsFiled          HealthReport[] @relation("Reporter")
  fieldVisits           FieldVisit[]   @relation("FieldWorker")
  casesAssigned         Case[]         @relation("VetAssigned")
  samplesProcessed      Sample[]       @relation("LabUser")

  // Relations for signup requirements
  farmerProfile         FarmerProfile?
  vetProfile            VetProfile?
  animalsSummary        AnimalSummary[]
  consents              Consent[]
  invitesCreated        Invite[]       @relation("InvitedBy")
}

model Animal {
  id              String         @id @default(cuid())
  species         String
  breed           String?
  age             Int?
  gender          String?
  weight          Float?
  village         String
  block           String
  district        String
  createdAt       DateTime       @default(now())
  
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id])
  
  healthReports   HealthReport[]
  vaccinations    Vaccination[]
  treatments      Treatment[]
  cases           Case[]
  samples         Sample[]
}

model HealthReport {
  id                String    @id @default(cuid())
  animalId          String
  animal            Animal    @relation(fields: [animalId], references: [id])
  reporterId        String
  reporter          User      @relation("Reporter", fields: [reporterId], references: [id])
  
  temperature       Float?
  duration          Int?      // In days
  severity          String    @default("MILD") // MILD, MODERATE, SEVERE
  animalsAffected   Int       @default(1)
  deaths            Int       @default(0)
  vaccinatedCount   Int       @default(0)
  locationVillage   String
  locationBlock     String
  locationDistrict  String
  latitude          Float?
  longitude         Float?
  additionalNotes   String?
  imageUrl          String?
  
  riskScore         Int       @default(0)
  riskLevel         String    @default("LOW") // LOW, MEDIUM, HIGH
  riskFactors       String?   // JSON string or comma-separated
  recommendedAction String?
  
  createdAt         DateTime  @default(now())
  
  symptoms          Symptom[]
  cases             Case[]
}

model Symptom {
  id             String       @id @default(cuid())
  name           String
  healthReportId String
  healthReport   HealthReport @relation(fields: [healthReportId], references: [id])
}

model Vaccination {
  id              String   @id @default(cuid())
  animalId        String
  animal          Animal   @relation(fields: [animalId], references: [id])
  vaccine         String
  date            DateTime
  nextDueDate     DateTime?
  veterinarianId  String?
  location        String?
  createdAt       DateTime @default(now())
}

model Case {
  id              String        @id @default(cuid())
  animalId        String
  animal          Animal        @relation(fields: [animalId], references: [id])
  healthReportId  String?
  healthReport    HealthReport? @relation(fields: [healthReportId], references: [id])
  veterinarianId  String?
  veterinarian    User?         @relation("VetAssigned", fields: [veterinarianId], references: [id])
  
  status          String        @default("NEW") // NEW, UNDER_REVIEW, FIELD_VISIT, TREATMENT, LAB_TEST, RECOVERED, REFERRED, CLOSED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  treatments      Treatment[]
  samples         Sample[]
  fieldVisits     FieldVisit[]
}

model Treatment {
  id              String    @id @default(cuid())
  caseId          String
  case            Case      @relation(fields: [caseId], references: [id])
  animalId        String
  animal          Animal    @relation(fields: [animalId], references: [id])
  
  assessment      String
  treatment       String
  medication      String?
  followUpDate    DateTime?
  notes           String?
  
  createdAt       DateTime  @default(now())
}

model Sample {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  animalId        String
  animal          Animal   @relation(fields: [animalId], references: [id])
  
  sampleType      String
  collectionDate  DateTime @default(now())
  collectedById   String
  
  laboratoryId    String?
  laboratory      Laboratory? @relation(fields: [laboratoryId], references: [id])
  labUserId       String?
  labUser         User?    @relation("LabUser", fields: [labUserId], references: [id])
  
  status          String   @default("COLLECTED") // COLLECTED, SENT_TO_LAB, RECEIVED, TESTING, RESULT_AVAILABLE
  result          String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Laboratory {
  id              String   @id @default(cuid())
  name            String
  location        String
  samples         Sample[]
}

model FieldVisit {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  fieldWorkerId   String
  fieldWorker     User     @relation("FieldWorker", fields: [fieldWorkerId], references: [id])
  
  visitDate       DateTime @default(now())
  findings        String
  status          String   @default("COMPLETED")
}

model Alert {
  id              String   @id @default(cuid())
  type            String   // HIGH_RISK, OUTBREAK_WARNING, VACCINATION_DUE, MORTALITY_SPIKE, LAB_RESULT, FIELD_VISIT, FOLLOW_UP
  message         String
  village         String?
  block           String?
  district        String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Notification {
  id              String   @id @default(cuid())
  userId          String?
  type            String
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String
  details         String
  createdAt       DateTime @default(now())
}

model OtpAttempt {
  id         String   @id @default(cuid())
  phone      String   @unique
  hashedCode String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}

model FarmerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  village   String?
  taluka    String
  district  String
  createdAt DateTime @default(now())
}

model AnimalSummary {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  species   String   // cow, buffalo, goat, sheep, poultry
  count     Int      @default(0)
  createdAt DateTime @default(now())
}

model VetProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vetType            String    @default("VET") // VET or PARA_VET
  registrationNo     String
  council            String
  certificateFileId  String?
  certificateUrl     String?
  serviceDistrict    String
  serviceTaluka      String
  serviceVillages    String?   // comma-separated or JSON
  languages          String?   // comma-separated e.g. "mr,hi,en"
  availability       String?
  reviewedBy         String?
  reviewedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime  @default(now())
}

model Consent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "DATA_TREATMENT" | "MEDIA_LOCATION_SHARING"
  accepted    Boolean  @default(true)
  textVersion String   @default("1.0")
  acceptedAt  DateTime @default(now())
}

model Invite {
  id                   String    @id @default(cuid())
  code                 String    @unique
  role                 String    // STATE_OFFICER, DISTRICT_OFFICER, TALUKA_OFFICER
  jurisdictionDistrict String?
  jurisdictionTaluka   String?
  createdById          String?
  createdBy            User?     @relation("InvitedBy", fields: [createdById], references: [id])
  expiresAt            DateTime
  usedAt               DateTime?
  usedByPhone          String?
  createdAt            DateTime  @default(now())
}

